# Скопируй этот файл в .env.local и подставь свои значения.
# .env.local в git не коммитится (см. .gitignore) — храни реальные ключи только там.

# Supabase (Settings -> API в проекте Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Только для сервера — никогда не должен попасть в клиентский бандл.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers -> API keys / Webhooks в дашборде Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Anthropic — используется для интерпретации поисковых запросов, извлечения данных
# со страниц, семантического ранжирования и т.д. (src/server/ai/client.ts).
# Опционально: если не задан, эти функции деградируют до детерминированного пути.
ANTHROPIC_API_KEY=

# Секрет для авторизации входящих запросов к cron-эндпоинтам.
CRON_SECRET=

# Публичные настройки сайта
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_URL=
